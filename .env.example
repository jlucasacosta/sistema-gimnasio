# .env.example · Forja Athletic Club
# Copialo como `.env.local` y completalo SOLO cuando conectes un backend real.
#   cp .env.example .env.local
# Este archivo se sube a GitHub: dejalo SIEMPRE con los valores vacios.
# `.env.local` (el tuyo, con valores reales) esta ignorado por git: no lo subas nunca.
# Guia paso a paso: docs/IMPLEMENTAR.md

# ---------------------------------------------------------------
# Supabase (base de datos + Auth)
# Se copian desde: Supabase > Project Settings > API (o el boton "Connect").
# ---------------------------------------------------------------
# Direccion de tu proyecto, tipo https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave publica (en el panel aparece como "anon" o "publishable"). Es segura para el
# navegador SOLO si activaste RLS en todas las tablas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servidor (en el panel aparece como "service_role" o "secret"). Se saltea RLS.
# JAMAS lleva el prefijo NEXT_PUBLIC_ ni se importa en un componente del navegador.
# La usan solo: el script de carga de datos (scripts/seed.mjs, en tu compu) y el worker de Railway.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Railway (tareas en segundo plano con pg-boss). Estas variables van en el
# servicio worker de Railway, no en el frontend.
# Cadena de conexion de Supabase en modo "Session pooler" (puerto 5432).
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# IA (usa UNA de las dos). Solo en el servidor (Route Handler), sin NEXT_PUBLIC_.
# ---------------------------------------------------------------
OPENAI_API_KEY=
# Nombre del modelo: elegilo de la documentacion del proveedor (cambian seguido).
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
